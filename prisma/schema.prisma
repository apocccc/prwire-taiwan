// 台湾ローカル向けプレスリリース配信メディア データモデル
// DB: PostgreSQL (Supabase / Neon を想定)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // アプリ実行時は pooler(6543)、migrate は direct(5432)
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- ユーザー・ロール ----------

enum Role {
  PUBLISHER // 事業者
  MEDIA     // メディア（記者・媒体）
  ADMIN     // 管理者・編集者
}

enum UserStatus {
  PENDING   // 承認待ち（メディアは管理者承認制）
  ACTIVE
  SUSPENDED
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String
  role            Role
  status          UserStatus  @default(PENDING)
  name            String?
  // 利用規約（事例利用許諾・メディア一覧公開・ダイレクト送付）への同意日時
  termsAcceptedAt DateTime?
  // 登録メールアドレス変更用（認証コード確認を経てから email を更新する）
  pendingEmail       String?
  emailChangeCode    String? // 6桁コードの bcrypt ハッシュ
  emailChangeExpires DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company     Company?
  mediaOutlet MediaOutlet?

  favorites      Favorite[]
  companyFollows CompanyFollow[]
}

// ---------- 事業者 ----------

model Company {
  id            String   @id @default(cuid())
  seq           Int      @unique @default(autoincrement()) // URL用の会社連番（PR TIMES風）
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String   @unique // /{locale}/company/[slug]
  nameZh        String
  nameEn        String?
  logoUrl       String?
  descriptionZh String?
  descriptionEn String?
  websiteUrl    String?

  // プレスリリースと合わせて掲載する会社基本情報
  address            String? // 住所
  representativeName String? // 代表者名
  capital            String? // 資本金（通貨・桁が多様なため文字列で保持）
  snsX               String?
  snsFacebook        String?
  snsInstagram       String?
  snsLine            String?
  snsYoutube         String?
  snsLinkedin        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  releases PressRelease[]
  follows  CompanyFollow[]
}

// ---------- メディア ----------

model MediaOutlet {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outletName   String // 媒体名（公開）
  outletUrl    String // 媒体URL（公開）
  contactName  String // 担当者名（非公開）
  contactTitle String? // 担当者の役職（非公開・開示時に事業者へ提供）
  contactEmail String // 連絡先メール（非公開）
  contactPhone String? // 担当者の電話番号（非公開・開示時に事業者へ提供）
  coverageArea String // カバー領域（公開）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryFollows    CategoryFollow[]
  disclosureRequests DisclosureRequest[]
}

// ---------- プレスリリース ----------

enum ReleaseStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
}

model PressRelease {
  id        String        @id @default(cuid())
  seq       Int           @unique @default(autoincrement()) // URL用の記事連番（PR TIMES風）
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug      String        @unique // 内部識別・後方互換用（旧URL）
  status    ReleaseStatus @default(DRAFT)

  // 多言語フィールド（片方のみでも公開可）
  titleZh    String?
  subtitleZh String?
  bodyZh     Json? // Tiptap JSON
  titleEn    String?
  subtitleEn String?
  bodyEn     Json? // Tiptap JSON

  // メタ description（リリース冒頭から自動生成・編集可）
  metaDescriptionZh String?
  metaDescriptionEn String?

  // 配信目的（商品・サービス / イベント 等。src/lib/purposes.ts のキー）
  purpose String?

  // サムネイル（必須・キャプション必須はアプリ側バリデーションで担保）
  thumbnailUrl     String?
  thumbnailCaption String?

  // このプレスリリースに関する連絡先情報（必須・メディア限定・開示請求で事業者へ通知）
  pressContactDept  String?
  pressContactName  String?
  pressContactEmail String?
  pressContactPhone String? // 台湾国コード +886 を含む

  scheduledAt DateTime? // 公開予約日時
  publishedAt DateTime?
  viewCount   Int       @default(0)
  reviewNote  String? // 差し戻し理由コメント

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images             ReleaseImage[]
  categories         ReleaseCategory[]
  mediaOnlyInfo      MediaOnlyInfo?
  mediaKitFiles      MediaKitFile[]
  disclosureRequests DisclosureRequest[]
  favorites          Favorite[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([companyId, status])
}

// メディア限定情報・連絡先の開示請求（誰が閲覧請求したかを事業者へ通知するため記録）
model DisclosureRequest {
  id            String       @id @default(cuid())
  releaseId     String
  release       PressRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  mediaOutletId String
  mediaOutlet   MediaOutlet  @relation(fields: [mediaOutletId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([releaseId, mediaOutletId])
  @@index([releaseId])
}

// 本文中画像（最大10枚はアプリ側で制約、キャプション必須）
model ReleaseImage {
  id        String       @id @default(cuid())
  releaseId String
  release   PressRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  url       String
  caption   String // alt属性と<figcaption>の両方に出力
  width     Int?
  height    Int?
  sortOrder Int          @default(0)

  @@index([releaseId])
}

// ---------- カテゴリ ----------

model Category {
  id        String @id @default(cuid())
  slug      String @unique // /{locale}/category/[slug]
  nameZh    String
  nameEn    String
  sortOrder Int    @default(0)

  releases ReleaseCategory[]
  follows  CategoryFollow[]
}

model ReleaseCategory {
  releaseId  String
  release    PressRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([releaseId, categoryId])
}

// メディアによるカテゴリフォロー（週次ダイジェスト用）
model CategoryFollow {
  mediaOutletId String
  mediaOutlet   MediaOutlet @relation(fields: [mediaOutletId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([mediaOutletId, categoryId])
}

// ---------- メディア限定コンテンツ ----------

// メディア向け情報（登録メディアのみ閲覧可・APIレベルでロール検証）
model MediaOnlyInfo {
  releaseId String       @id
  release   PressRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  content   String
  updatedAt DateTime     @updatedAt
}

// メディアキット（登録メディアのみDL可・署名付きURLで配信）
model MediaKitFile {
  id        String       @id @default(cuid())
  releaseId String
  release   PressRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  fileKey   String // ストレージ上のキー（直リンク不可、署名付きURLを都度発行）
  fileName  String
  fileSize  Int // bytes
  mimeType  String
  createdAt DateTime     @default(now())

  @@index([releaseId])
}

// ---------- お気に入り・企業フォロー（ログインユーザー、主にメディア） ----------

// お気に入り登録した記事
model Favorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseId String
  release   PressRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, releaseId])
  @@index([userId])
}

// フォロー中の企業
model CompanyFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
}

// ---------- サイト設定（管理画面から変更可能な項目） ----------

model SiteSetting {
  id             Int      @id @default(1)
  reviewRequired Boolean  @default(false) // 審査フローON/OFF（既定OFF＝レビューなしで即配信）
  serviceNameZh  String?
  serviceNameEn  String?
  logoUrl        String?
  footerTextZh   String?
  footerTextEn   String?
  updatedAt      DateTime @updatedAt
}
