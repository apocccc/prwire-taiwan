# ===== データベース（Supabase Postgres）=====
# アプリ実行時: Transaction pooler(6543) + pgbouncer
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# migrate 用: Direct(5432)
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ローカル開発では従来どおりローカル Postgres でも可:
# DATABASE_URL="postgresql://user:password@localhost:5432/twpr?schema=public"
# DIRECT_URL="postgresql://user:password@localhost:5432/twpr?schema=public"

# ===== 認証（Auth.js）=====
# 生成: npx auth secret  または  openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# ===== 公開URL（メタタグ・canonical・sitemap 用）=====
NEXT_PUBLIC_SITE_URL="https://taiwanpublicwire.com"

# ===== ストレージ（Cloudflare R2, S3互換）=====
# 未設定ならローカルディスクにフォールバック（ローカル開発用）
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PUBLIC="tpw-public"
R2_BUCKET_PRIVATE="tpw-private"
# 公開画像の配信URL（DNS設定後・フェーズ4）
NEXT_PUBLIC_R2_PUBLIC_URL="https://img.taiwanpublicwire.com"

# ===== メール送信（Resend）=====
RESEND_API_KEY=""
EMAIL_FROM="noreply@taiwanpublicwire.info"

# ===== シード用管理者アカウント =====
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin-change-me"
